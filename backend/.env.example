# ---------------------------------------------------------------------------
# PawfectHome API — copy to .env and fill in.
# Keys marked [Batch N] are not needed until that batch; the server boots
# without them and /health reports them as not_configured.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# Set to true ONLY when running the full test suite (tests/run-all.ps1). The suites share the
# in-memory rate-limit budgets and would otherwise starve each other. Ignored in production.
DISABLE_RATE_LIMIT=false

# Comma-separated list of allowed CORS origins. First entry is canonical.
FRONTEND_URL=http://localhost:3000

# --- [Batch 2] Database ----------------------------------------------------
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pawfecthome?retryWrites=true&w=majority
# Left blank deliberately — a placeholder value would make /health report db as configured.
MONGODB_URI=

# --- [Batch 2] Auth --------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Use DIFFERENT values for access and refresh.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Leave blank in development. In production set the shared parent domain,
# e.g. .pawfecthome.org, so cookies work across api. and www. subdomains.
COOKIE_DOMAIN=

# --- [Batch 2] Google OAuth ------------------------------------------------
# Authorised redirect URI: http://localhost:5000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- [Batch 10] Cloudinary -------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- [Batch 13] Stripe -----------------------------------------------------
STRIPE_SECRET_KEY=
# From: stripe listen --forward-to localhost:5000/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- [Batch 13] eSewa (NPR payment gateway) --------------------------------
# Ships with eSewa's PUBLIC UAT sandbox defaults, so donations via eSewa work out of the box.
# For production, get a merchant code + secret from eSewa and set ESEWA_ENV=production.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET=8gBm/:&EnhH.1/q
ESEWA_ENV=test

# --- [Batch 6] Email -------------------------------------------------------
# Development: use a Mailtrap or Ethereal inbox rather than a real provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=PawfectHome <no-reply@pawfecthome.org>
